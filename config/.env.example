# Copy this file to your Hermes home as ~/.hermes/.env and fill in real values.
# NEVER commit the filled-in .env. All values below are placeholders.

# --- Discord ---
DISCORD_BOT_TOKEN=your-discord-bot-token          # Bot token from the Discord Developer Portal (Bot tab)
DISCORD_ALLOW_ALL_USERS=true                       # true = anyone in the server can talk to the bot
DISCORD_HOME_CHANNEL=000000000000000000            # (optional) channel id for the bot's own status/cron messages
DISCORD_HOME_CHANNEL_THREAD_ID=                    # (optional) thread id within the home channel

# --- LLM (the conversation brain) ---
OPENAI_API_KEY=sk-your-openai-key                  # Used by the default model in config.yaml (gpt-4o)

# --- TTS provider (swappable; this build uses Murf Falcon) ---
MURF_API_KEY=your-murf-api-key                     # Get one at https://murf.ai/api
MURF_DEFAULT_VOICE=en-US-terrell                   # Any voice id from your Murf catalog

# --- STT (speech-to-text; Whisper via Groq's free tier) ---
GROQ_API_KEY=gsk_your-groq-key                     # Get one at https://console.groq.com
