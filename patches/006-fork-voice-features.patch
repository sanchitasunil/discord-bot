+class StreamingMixerChild:
+    """A speech child fed incrementally as audio arrives, instead of
+    :class:`MixerChild`'s fixed-at-construction buffer.
+
+    Built for live-streaming TTS: ``append()`` is called from a producer
+    thread (e.g. a Falcon/streaming-TTS websocket) as chunks arrive, while
+    :meth:`read_frame` is polled every 20ms from discord.py's audio sender
+    thread, same as ``MixerChild``. A frame slot with nothing buffered yet
+    returns silence rather than ending the child — the producer may still
+    be mid-flight — so a brief stall never drops the reply; only an
+    explicit :meth:`close` with a fully drained buffer ends it.
+    """
+
+    __slots__ = ("gain", "fade_frames", "_fade_done", "_lock", "_buf", "_pos", "_done")
+
+    def __init__(self, *, gain: float = 1.0, fade_in_ms: int = 40):
+        self.gain = float(gain)
+        self.fade_frames = max(0, fade_in_ms // FRAME_LENGTH_MS)
+        self._fade_done = 0
+        self._lock = threading.Lock()
+        self._buf = bytearray()
+        self._pos = 0
+        self._done = False
+
+    def append(self, stereo_pcm: bytes) -> None:
+        """Append already-stereo 48kHz s16le PCM bytes."""
+        if not stereo_pcm:
+            return
+        with self._lock:
+            self._buf.extend(stereo_pcm)
+
+    def close(self) -> None:
+        """Signal that no more audio is coming; the tail drains then finishes."""
+        with self._lock:
+            self._done = True
+
+    def flush(self) -> None:
+        """Drop all un-played audio immediately (barge-in) and end the child.
+
+        The streaming TTS backend (Murf Falcon) delivers audio several
+        seconds ahead of real time, so this buffer holds what the bot would
+        otherwise keep speaking after an interrupt. Clearing it is what makes
+        the bot actually go quiet fast; ``read_frame`` then returns None and
+        the mixer drops this child."""
+        with self._lock:
+            self._buf = bytearray()
+            self._pos = 0
+            self._done = True
+
+    def pending_bytes(self) -> int:
+        """Un-played audio still buffered — >0 means this child is audibly
+        playing right now. Gates barge-in detection to the real playback
+        window (Murf front-loads ~4s, so the producer finishes long before
+        playback does)."""
+        with self._lock:
+            return max(0, len(self._buf) - self._pos)
+
+    def read_frame(self) -> "Optional[np.ndarray]":
+        """Return the next 20ms frame, or None once fully drained and closed."""
+        with self._lock:
+            available = len(self._buf) - self._pos
+            if available >= FRAME_SIZE:
+                chunk = bytes(self._buf[self._pos:self._pos + FRAME_SIZE])
+                self._pos += FRAME_SIZE
+            elif self._done:
+                if available <= 0:
+                    return None
+                chunk = bytes(self._buf[self._pos:]) + b"\x00" * (FRAME_SIZE - available)
+                self._pos = len(self._buf)
+            else:
+                # Producer hasn't caught up yet — hold this slot with
+                # silence instead of evicting the child; more audio may
+                # still be appended on the next read.
+                np = _require_numpy()
+                return np.zeros(FRAME_SIZE // 2, dtype=np.float32)
+
+        np = _require_numpy()
+        samples = np.frombuffer(chunk, dtype=np.int16).astype(np.float32)
+        gain = self.gain
+        if self.fade_frames and self._fade_done < self.fade_frames:
+            self._fade_done += 1
+            gain *= self._fade_done / self.fade_frames
+        if gain != 1.0:
+            samples = samples * gain
+        return samples
+
