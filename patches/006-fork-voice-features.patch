+            cfg = _load_gateway_config() or {}
+            voice_cfg = cfg.get("voice") or {}
+            recap = voice_cfg.get("recap") or {}
+            return recap if isinstance(recap, dict) else {}
+        except Exception:
+            return {}
+
+    def _record_voice_turn(self, guild_id: int, speaker: str, text: str) -> None:
+        """Append one attributed turn to this guild's voice-session log, if a
+        session is active. No-op when recap is disabled or no session is open.
+        Bounded to max_turns so a very long session can't grow unbounded."""
+        text = (text or "").strip()
+        if not text:
+            return
+        log_store = getattr(self, "_voice_session_log", None)
+        if not isinstance(log_store, dict) or guild_id not in log_store:
+            return
+        recap_cfg = self._voice_recap_config()
+        if not recap_cfg.get("enabled"):
+            return
+        try:
+            max_turns = int(recap_cfg.get("max_turns", 500))
+        except (TypeError, ValueError):
+            max_turns = 500
+        entries = log_store[guild_id]
+        entries.append({"speaker": str(speaker), "text": text})
+        if len(entries) > max_turns:
+            # Keep the most recent max_turns (recap favors the latest arc of a
+            # long session; also bounds the summary prompt token cost).
+            del entries[: len(entries) - max_turns]
