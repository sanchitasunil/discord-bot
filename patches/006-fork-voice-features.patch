+if DISCORD_AVAILABLE:
+    class _LiveTTSAudioSource(discord.AudioSource):
+        """Feeds a live/streaming TTS backend directly into ``vc.play()``.
+
+        Used only when no continuous mixer is installed for the guild (see
+        :meth:`DiscordAdapter.speak_live`). Frames are pulled from an
+        internal buffer that a background producer thread appends to as
+        audio arrives from the TTS websocket, instead of ``vc.play()``
+        reading a file that was fully synthesized before playback began.
+        """
+
+        FRAME_SIZE = 3840  # discord.opus.Encoder.FRAME_SIZE: 20ms @ 48kHz stereo s16le
+
+        def __init__(self):
+            self._lock = threading.Lock()
+            self._buf = bytearray()
+            self._pos = 0
+            self._done = False
+
+        def append(self, stereo_pcm: bytes) -> None:
+            if not stereo_pcm:
+                return
+            with self._lock:
+                self._buf.extend(stereo_pcm)
+
+        def close(self) -> None:
+            with self._lock:
+                self._done = True
+
+        def flush(self) -> None:
+            """Drop all un-played audio immediately (barge-in). Murf streams
+            several seconds ahead of real time, so this local buffer holds the
+            audio the bot would otherwise keep speaking after an interrupt —
+            clearing it is what actually makes the bot go quiet fast. Marks the
+            source done so ``read`` returns end-of-stream and playback stops."""
+            with self._lock:
+                self._buf = bytearray()
+                self._pos = 0
+                self._done = True
+
+        def pending_bytes(self) -> int:
+            """Un-played audio still buffered — >0 means the bot is audibly
+            speaking right now (used to gate barge-in detection to the real
+            playback window, not the producer's lifecycle)."""
+            with self._lock:
+                return max(0, len(self._buf) - self._pos)
+
+        def read(self) -> bytes:
+            with self._lock:
+                available = len(self._buf) - self._pos
+                if available >= self.FRAME_SIZE:
+                    chunk = bytes(self._buf[self._pos:self._pos + self.FRAME_SIZE])
+                    self._pos += self.FRAME_SIZE
+                    return chunk
+                if self._done:
+                    if available <= 0:
+                        return b""
+                    chunk = bytes(self._buf[self._pos:]) + b"\x00" * (self.FRAME_SIZE - available)
+                    self._pos = len(self._buf)
+                    return chunk
+                # Producer hasn't caught up yet — hold with silence rather
+                # than ending the stream; more audio may still arrive.
+                return b"\x00" * self.FRAME_SIZE
+
+        def is_opus(self) -> bool:
+            return False
+else:
+    _LiveTTSAudioSource = None
