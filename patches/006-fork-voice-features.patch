+    async def _apply_voice_switch_marker(self, source: SessionSource, text: str) -> str:
+        """Detect a ``[[SWITCH_VOICE: query]]`` / ``[[SAMPLE_VOICE: query]]``
+        marker the agent can emit when a user asks — in plain conversation,
+        not a slash command — to change or preview the Murf voice.
+        Resolves *query* against the real voice catalog, applies it
+        (persists as the guild's voice for SWITCH; plays a one-off preview
+        for SAMPLE, without persisting), and returns *text* with the
+        marker stripped either way. Returns *text* unchanged if there's no
+        marker, the platform isn't Discord, or nothing matches — this is
+        always safe to call on any response.
+        """
+        match = _VOICE_SWITCH_TAG_RE.search(text)
+        if not match or source.platform != Platform.DISCORD:
+            return text
+        cleaned = _VOICE_SWITCH_TAG_RE.sub("", text).strip()
+        # group(1) is the full verb (SWITCH_VOICE / SAMPLE_VOICE /
+        # SPEAK_LANGUAGE); reduce to the action word.
+        verb, query = match.group(1).upper(), match.group(2).strip()
+        action = verb.split("_")[0]  # SWITCH | SAMPLE | SPEAK
+
+        # SPEAK_LANGUAGE is handled live mid-stream (see _handle_language_marker
+        # in _run_agent_inner); by the time it could reach this post-turn
+        # resolver the reply is already spoken, so here we only strip it.
+        if action == "SPEAK":
+            return cleaned
+
+        adapter = self.adapters.get(Platform.DISCORD)
+        if adapter is None:
+            return cleaned
+        vtc = getattr(adapter, "_voice_text_channels", None)
+        guild_id = None
+        if isinstance(vtc, dict):
+            for gid, tc in vtc.items():
+                if str(tc) == str(source.chat_id):
+                    guild_id = gid
+                    break
+        if guild_id is None:
+            # Not currently connected to voice for any guild linked to this
+            # channel — SWITCH_VOICE should still work from plain text chat,
+            # since it's just a persisted per-guild preference, not
+            # something that requires an active voice session (confirmed
+            # gap: a user asking "switch to X" in a text channel with no
+            # live voice connection got told the bot "can't flip the voice
+            # from here" and offered API/Studio instructions instead, since
+            # this whole mechanism had no way to resolve a guild at all).
+            # Resolve the guild directly from the channel instead.
+            client = getattr(adapter, "_client", None)
+            try:
+                channel = client.get_channel(int(source.chat_id)) if client else None
+                guild = getattr(channel, "guild", None)
+                if guild is not None:
+                    guild_id = guild.id
+            except (TypeError, ValueError, AttributeError):
+                pass
+        if guild_id is None:
+            return cleaned
+
+        try:
+            provider, voices = self._resolve_murf_provider_and_voices()
+            if provider is None:
+                return cleaned
+            voice_match, _candidates = self._match_voice_query(query, voices)
+            if voice_match is None:
+                return cleaned
+            # Strip the "(F)"/"(M)" suffix from the display name before
+            # speaking it — that's meant for text lists, not to be read
+            # aloud literally as "Alina F" mid-sentence.
+            spoken_name = re.sub(
+                r"\s*\([MF]\)\s*$", "", str(voice_match.get("display") or voice_match["id"]),
+            )
+            if action == "SWITCH" and hasattr(adapter, "set_guild_voice"):
+                adapter.set_guild_voice(guild_id, voice_match["id"])
+                # Confirm the switch by actually speaking in the new voice —
+                # the model's own text (before the tag) just says it's
+                # switching, this is the audible proof it happened, in the
+                # voice itself. Not a question back to the user.
+                if hasattr(adapter, "speak_live"):
+                    await adapter.speak_live(
+                        str(source.chat_id),
+                        f"Hey, this is {spoken_name}.",
+                        voice_override=voice_match["id"],
+                    )
+            elif action == "SAMPLE" and hasattr(adapter, "speak_live"):
+                await adapter.speak_live(
+                    str(source.chat_id),
+                    f"Here's how {spoken_name} sounds.",
+                    voice_override=voice_match["id"],
+                )
+        except Exception as exc:
+            logger.debug("Voice switch marker handling failed: %s", exc)
+        return cleaned
