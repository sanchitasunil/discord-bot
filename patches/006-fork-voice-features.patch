+# Lets the agent switch or preview a Murf voice, or switch the spoken
+# language, from plain conversation without a formal tool call — the model
+# emits one of these markers in its reply, the gateway resolves it and
+# strips the tag before the text is shown or spoken.
+#   [[SWITCH_VOICE: q]]    persist a new guild voice        (handled post-turn)
+#   [[SAMPLE_VOICE: q]]    one-off preview of a voice       (handled post-turn)
+#   [[SPEAK_LANGUAGE: q]]  transient per-turn language switch (handled live, mid-stream)
+# Mirrors the existing MEDIA:/[[audio_as_voice]] tag-interception pattern.
+_VOICE_SWITCH_TAG_RE = re.compile(
+    r"\[\[(SWITCH_VOICE|SAMPLE_VOICE|SPEAK_LANGUAGE):\s*([^\]]+)\]\]", re.IGNORECASE
+)
+
+# Language switching rides on en-IN-anisha's MultiNative capability: these
+# are the locales that voice can speak natively (verified live against the
+# Murf Falcon catalog 2026-07-27 — en-IN-anisha.supportedLocales). Switching
+# to any of these needs only a locale change on the same voice, no reconnect
+# (see MurfLiveSession.switch). Kept as a constant so the hot streaming path
+# never makes a network round-trip to resolve a language. Note: Telugu
+# (te-IN), Odia (or-IN) and Assamese (as-IN) have NO standalone Falcon voice
+# but Anisha speaks them, which is exactly why we route language switching
+# through her rather than hunting per-language native voices.
+_ANISHA_LOCALES = frozenset({
+    "ml-IN", "te-IN", "pa-IN", "as-IN", "or-IN", "ta-IN",
+    "bn-IN", "hi-IN", "kn-IN", "mr-IN", "en-IN",
+})
+_LANGUAGE_SWITCH_VOICE = "en-IN-anisha"
+
+# Speaker label used for the bot's own turns in the voice-session recap log
+# (Feature 2). Distinct from any human speaker name so recap can separate
+# questions (humans) from answers (bot).
+_RECAP_BOT_SPEAKER = "Murf bot"
+_LANGUAGE_TO_LOCALE = {
+    "english": "en-IN", "hindi": "hi-IN", "tamil": "ta-IN",
+    "bengali": "bn-IN", "bangla": "bn-IN", "telugu": "te-IN",
+    "malayalam": "ml-IN", "kannada": "kn-IN", "marathi": "mr-IN",
+    "punjabi": "pa-IN", "odia": "or-IN", "oriya": "or-IN", "assamese": "as-IN",
+}
+
+
+def _resolve_language_locale(query: str) -> Optional[str]:
+    """Map a ``[[SPEAK_LANGUAGE: q]]`` query to a Murf locale Anisha can
+    speak, or None if it isn't a supported language. Accepts a language
+    name ("Hindi", "tamil") or a raw locale ("hi-IN"). Unsupported
+    languages (Gujarati, French, etc.) return None on purpose — SOUL.md
+    tells the model to decline those in English rather than emit the tag.
+    """
+    q = (query or "").strip().lower()
+    if not q:
+        return None
+    locale = _LANGUAGE_TO_LOCALE.get(q)
+    if locale is None:
+        # allow a raw locale like "hi-IN"
+        for loc in _ANISHA_LOCALES:
+            if loc.lower() == q:
+                locale = loc
+                break
+    if locale and locale in _ANISHA_LOCALES:
+        return locale
+    return None
+
+
+class _MarkerDeltaFilter:
+    """Buffers raw token deltas so a ``[[SWITCH_VOICE: ...]]``/
+    ``[[SAMPLE_VOICE: ...]]`` marker can never reach a live delivery sink
+    (the streamed Discord message text, or the sentence-by-sentence TTS
+    feed) even partially, while it's still being generated token-by-token.
+
+    The three existing marker-stripping call sites (final response text,
+    interim/commentary messages, and the live-speech trailing flush) only
+    ever see a *complete* string, so a simple regex substitution is enough
+    there. This is the fourth path — raw incremental deltas handed to
+    ``GatewayStreamConsumer.on_delta``/the live-speech sentence feed as
+    the model generates them — and a regex can't help mid-generation: by
+    the time ``]]`` arrives to complete the match, the ``[[SAMPLE_VOICE:``
+    prefix has already been forwarded and displayed/spoken. Confirmed in
+    practice: the raw tag showed up verbatim in the Discord message text.
+
+    Everything before an unclosed ``[[`` is forwarded immediately (so
+    normal streaming latency is unaffected); text from ``[[`` onward is
+    held back until a matching ``]]`` arrives, then either dropped (and
+    handed to *on_marker* for side-effect handling) if it's a real marker,
+    or forwarded as plain text if it happens not to be.
+    """
+
+    def __init__(self, on_output, on_marker):
+        self._buf = ""
+        self._on_output = on_output
+        self._on_marker = on_marker
+
+    def feed(self, delta: str) -> None:
+        if not delta:
+            return
+        self._buf += delta
+        while True:
+            start = self._buf.find("[[")
+            if start == -1:
+                if self._buf:
+                    self._on_output(self._buf)
+                    self._buf = ""
+                return
+            if start > 0:
+                self._on_output(self._buf[:start])
+                self._buf = self._buf[start:]
+            end = self._buf.find("]]")
+            if end == -1:
+                # Marker still incomplete — hold back and wait for more.
+                return
+            candidate = self._buf[:end + 2]
+            self._buf = self._buf[end + 2:]
+            if _VOICE_SWITCH_TAG_RE.fullmatch(candidate):
+                self._on_marker(candidate)
+            else:
+                self._on_output(candidate)
+
+    def flush(self) -> None:
+        """Forward whatever's left unresolved (e.g. stream ended mid-tag)."""
+        if self._buf:
+            self._on_output(self._buf)
+            self._buf = ""
+
+
