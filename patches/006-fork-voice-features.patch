+def _mono16_to_stereo16(mono: bytes) -> bytes:
+    """Duplicate mono 16-bit PCM samples into interleaved stereo (L=R).
+
+    Murf's streaming WS sends mono; Discord voice (and the mixer) require
+    stereo. Used to feed live TTS chunks straight into voice playback
+    instead of waiting for a full file to be written and converted.
+    """
+    if not mono:
+        return b""
+    usable = len(mono) - (len(mono) % 2)
+    if usable <= 0:
+        return b""
+    import array
+    mono_samples = array.array("h")
+    mono_samples.frombytes(mono[:usable])
+    n = len(mono_samples)
+    stereo = array.array("h", bytes(4 * n))
+    stereo[0::2] = mono_samples
+    stereo[1::2] = mono_samples
+    return stereo.tobytes()
+
